---
interface Props {
  locale: "en" | "zh";
}
const { locale } = Astro.props;
const english = locale === "en";
---

<!doctype html>
<html lang={english ? "en" : "zh-CN"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    {
      !import.meta.env.DEV && (
        <meta
          http-equiv="Content-Security-Policy"
          content="default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
        />
      )
    }
    <title>
      {english ? "VeriSilo · Interactive demo" : "VeriSilo · 交互演示"}
    </title>
  </head>
  <body>
    <div id="demo-root">
      <p>
        {
          english
            ? "Opening the VeriSilo interactive demo…"
            : "正在展开 VeriSilo 交互演示…"
        }
      </p>
    </div>
    <noscript
      >{
        english
          ? "This interactive demo requires JavaScript. You can still read about VeriSilo on the website."
          : "此交互演示需要 JavaScript。你仍可以回到官网阅读产品介绍。"
      }</noscript
    >
    <script>
      import "../../../desktop/src/preview/public";
    </script>
  </body>
</html>
