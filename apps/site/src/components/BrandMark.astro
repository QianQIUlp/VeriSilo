---
interface Props {
  size?: "small" | "large";
}

const { size = "small" } = Astro.props;
---

<svg
  class:list={["brand-mark", `brand-mark--${size}`]}
  viewBox="0 0 96 96"
  fill="none"
  aria-hidden="true"
>
  <path
    class="brand-wing brand-wing-blue"
    fill="#1553ff"
    d="M8 12 31 21C29 41 32 55 42 62L31 81C11 66 6 44 8 12Z"></path>
  <path
    class="brand-wing brand-wing-copper"
    fill="#ff6034"
    d="M42 27C53 9 73 4 90 8 78 38 60 64 42 77L45 53C57 40 65 27 67 22 61 23 54 29 50 35L42 27Z"
  ></path>
</svg>
