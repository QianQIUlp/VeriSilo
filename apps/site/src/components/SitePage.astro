---
import BrandMark from "./BrandMark.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { copy, links, type Locale } from "../content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = copy[locale];
const homeHref = locale === "zh" ? "/zh/" : "/";
const languageHref = locale === "zh" ? "/" : "/zh/";
---

<BaseLayout
  locale={locale}
  title={content.meta.title}
  description={content.meta.description}
>
  <a class="skip-link" href="#main">{content.skipLink}</a>

  <header class="site-header">
    <div class="header-inner">
      <a class="wordmark" href={homeHref} aria-label={content.homeLabel}>
        <BrandMark />
        <span>VeriSilo</span>
      </a>

      <nav class="primary-nav" aria-label={content.navigation.aria}>
        <a href="#how">{content.navigation.how}</a>
        <a href="#evidence">{content.navigation.evidence}</a>
        <a href="#boundaries">{content.navigation.boundaries}</a>
        <a href="#source">{content.navigation.source}</a>
      </nav>

      <a
        class="language-link"
        href={languageHref}
        lang={locale === "zh" ? "en" : "zh-CN"}
        hreflang={locale === "zh" ? "en" : "zh-CN"}
      >
        {content.languageLabel}
      </a>
    </div>
  </header>

  <main id="main">
    <section class="hero page-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">
          <span aria-hidden="true"></span>{content.hero.eyebrow}
        </p>
        <h1 id="hero-title">
          <span>{content.hero.titleLead}</span>
          <strong>{content.hero.titleEmphasis}</strong>
        </h1>
        <p class="hero-body">{content.hero.body}</p>
        <div class="hero-actions">
          <a
            class="button button--primary"
            href={links.repository}
            target="_blank"
            rel="noreferrer"
          >
            {content.hero.primaryAction}
            <span aria-hidden="true">↗</span>
          </a>
          <a class="button button--text" href="#how">
            {content.hero.secondaryAction}
            <span aria-hidden="true">↓</span>
          </a>
        </div>
        <p class="release-note">
          <span aria-hidden="true">i</span>
          {content.hero.releaseNote}
        </p>
      </div>

      <figure class="state-map" aria-label={content.model.aria}>
        <div class="state-map__topbar">
          <div class="state-map__lights" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <span>{content.model.title}</span>
          <span class="state-map__live">
            <i aria-hidden="true"></i>{content.model.live}
          </span>
        </div>

        <div class="state-map__body">
          <article class="profile profile--default">
            <div class="profile__head">
              <span class="profile__kind">{content.model.defaultLabel}</span>
              <span class="status status--quiet"
                >{content.model.defaultStatus}</span
              >
            </div>
            <h2>{content.model.defaultName}</h2>
            <code>{content.model.defaultPath}</code>
            <div class="token-row">
              {content.model.defaultTokens.map((token) => <span>{token}</span>)}
            </div>
          </article>

          <div class="boundary" aria-hidden="true">
            <span>{content.model.boundaryTop}</span>
            <i></i>
            <span>{content.model.boundaryBottom}</span>
          </div>

          <div class="silo-zone">
            <p>{content.model.siloLabel}</p>
            <article class="profile profile--silo profile--active">
              <div class="profile__head">
                <span class="profile__kind">SILO 01</span>
                <span class="status status--active">{content.model.active}</span
                >
              </div>
              <h2>{content.model.firstSilo}</h2>
              <code>{content.model.path}</code>
              <div class="token-row">
                {content.model.siloTokens.map((token) => <span>{token}</span>)}
              </div>
            </article>
            <article class="profile profile--silo profile--standby">
              <div class="profile__head">
                <span class="profile__kind">SILO 02</span>
                <span class="status status--ready">{content.model.ready}</span>
              </div>
              <h2>{content.model.secondSilo}</h2>
              <code>{content.model.path}</code>
            </article>
          </div>
        </div>

        <div class="state-map__command">
          <span>{content.model.commandLabel}</span>
          <code>{content.model.command}</code>
          <b aria-hidden="true">✓</b>
        </div>
        <figcaption>{content.model.caption}</figcaption>
      </figure>
    </section>

    <section class="fact-strip" aria-label={content.factsLabel}>
      <div class="page-shell fact-strip__inner">
        {
          content.facts.map((fact) => (
            <div class="fact">
              <span>{fact.label}</span>
              <strong>{fact.value}</strong>
              <small>{fact.detail}</small>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section section--how page-shell" id="how">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">{content.how.eyebrow}</p>
          <h2>{content.how.title}</h2>
        </div>
        <p>{content.how.intro}</p>
      </div>

      <ol class="steps">
        {
          content.how.steps.map((step, index) => (
            <li class="step">
              <div class="step__index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </div>
              <div class="step__line" aria-hidden="true">
                <span />
              </div>
              <div class="step__content">
                <span class="step__label">{step.label}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
                <small>{step.note}</small>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section section--evidence" id="evidence">
      <div class="page-shell evidence-layout">
        <div class="evidence-copy">
          <p class="eyebrow eyebrow--light">{content.evidence.eyebrow}</p>
          <h2>{content.evidence.title}</h2>
          <p>{content.evidence.intro}</p>
          <a
            class="text-link text-link--light"
            href={links.capabilities}
            target="_blank"
            rel="noreferrer"
          >
            {content.evidence.docsAction}<span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="evidence-board">
          <div class="pipeline">
            <p>{content.evidence.pipelineLabel}</p>
            <ol>
              {
                content.evidence.pipeline.map((state, index) => (
                  <li>
                    <span aria-hidden="true">
                      {index === 2 ? "✓" : index + 1}
                    </span>
                    <strong>{state}</strong>
                  </li>
                ))
              }
            </ol>
            <small>{content.evidence.pipelineNote}</small>
          </div>

          <div class="capability-list">
            {
              content.evidence.levels.map((level) => (
                <article class={`capability capability--${level.tone}`}>
                  <span>{level.tier}</span>
                  <div>
                    <h3>{level.title}</h3>
                    <p>{level.body}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section section--architecture page-shell">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">{content.architecture.eyebrow}</p>
          <h2>{content.architecture.title}</h2>
        </div>
        <div class="section-heading__aside">
          <p>{content.architecture.intro}</p>
          <a
            class="text-link"
            href={links.architecture}
            target="_blank"
            rel="noreferrer"
          >
            {content.architecture.docsAction}<span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="architecture-map">
        {
          content.architecture.nodes.map((node, index) => (
            <article class="architecture-node">
              <div class="architecture-node__port" aria-hidden="true">
                <span />
              </div>
              <span class="architecture-node__kind">{node.kind}</span>
              <h3>{node.title}</h3>
              <p>{node.body}</p>
              {index < content.architecture.nodes.length - 1 && (
                <span class="architecture-node__arrow" aria-hidden="true">
                  →
                </span>
              )}
            </article>
          ))
        }
      </div>
      <p class="architecture-note">
        <span aria-hidden="true">i</span>{content.architecture.footnote}
      </p>
    </section>

    <section class="section section--boundaries" id="boundaries">
      <div class="page-shell">
        <div class="boundaries-heading">
          <p class="eyebrow eyebrow--warm">{content.boundaries.eyebrow}</p>
          <h2>{content.boundaries.title}</h2>
          <p>{content.boundaries.intro}</p>
        </div>

        <div class="boundary-grid">
          {
            content.boundaries.items.map((item) => (
              <article>
                <span aria-hidden="true">×</span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>

        <a
          class="text-link text-link--light boundary-link"
          href={links.threatModel}
          target="_blank"
          rel="noreferrer"
        >
          {content.boundaries.docsAction}<span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="section section--source page-shell" id="source">
      <div class="source-card">
        <div class="source-card__mark" aria-hidden="true">
          <BrandMark size="large" />
        </div>
        <div class="source-card__copy">
          <p class="eyebrow">{content.source.eyebrow}</p>
          <h2>{content.source.title}</h2>
          <p>{content.source.body}</p>
          <div class="source-actions">
            <a
              class="button button--primary"
              href={links.repository}
              target="_blank"
              rel="noreferrer"
            >
              {content.source.primaryAction}<span aria-hidden="true">↗</span>
            </a>
            <a
              class="button button--outlined"
              href={links.development}
              target="_blank"
              rel="noreferrer"
            >
              {content.source.secondaryAction}
            </a>
          </div>
        </div>
        <dl class="source-meta">
          <div>
            <dt>{content.source.statusLabel}</dt>
            <dd><i aria-hidden="true"></i>{content.source.statusValue}</dd>
          </div>
          <div>
            <dt>{content.source.platformLabel}</dt>
            <dd>{content.source.platformValue}</dd>
          </div>
          <div>
            <dt>{content.source.licenseLabel}</dt>
            <dd>{content.source.licenseValue}</dd>
          </div>
        </dl>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="page-shell footer-inner">
      <div class="footer-brand">
        <a class="wordmark" href={homeHref}>
          <BrandMark />
          <span>VeriSilo</span>
        </a>
        <p>{content.footer.tagline}</p>
      </div>
      <p class="footer-status">
        <span aria-hidden="true"></span>{content.footer.status}
      </p>
      <div class="footer-links">
        <a href={links.repository} target="_blank" rel="noreferrer">GitHub</a>
        <a href={links.threatModel} target="_blank" rel="noreferrer">
          {content.navigation.boundaries}
        </a>
        <a href={links.license} target="_blank" rel="noreferrer">
          {content.footer.license}
        </a>
      </div>
    </div>
  </footer>
</BaseLayout>
