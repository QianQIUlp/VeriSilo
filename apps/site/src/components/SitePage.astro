---
import BrandMark from "./BrandMark.astro";
import IdentityContour from "./IdentityContour.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { copy, links, type Locale } from "../content";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = copy[locale];
const identities = [
  "9f2c6a51-4b7e-4c1a-9d3e-5a1b2c3d4e5f",
  "c3e82c0e-83e9-49ee-b152-44f9e22f131b",
  "creative-workspace",
];
const homeHref = locale === "zh" ? "/zh/" : "/";
const demoHref = `${locale === "zh" ? "/demo/" : "/demo/en/"}?scene=matched`;
---

<BaseLayout
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
>
  <a class="skip-link" href="#main">{c.skipLink}</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="wordmark" href={homeHref} aria-label={c.homeLabel}
        ><BrandMark /><span>VeriSilo</span></a
      >
      <nav
        class="primary-nav"
        aria-label={locale === "zh" ? "主导航" : "Navigation"}
      >
        <a href="#experience">{c.nav[0]}<span aria-hidden="true">↗</span></a>
        <a href="#difference">{c.nav[1]}</a>
        <a href="#download">{c.nav[2]}</a>
      </nav>
      <div class="header-controls">
        <label class="site-motion"
          ><span>{c.motion}</span><select
            aria-label={c.motion}
            id="site-motion"
          >
            {
              ["system", "full", "reduce"].map((value, index) => (
                <option value={value}>{c.motionOptions[index]}</option>
              ))
            }
          </select></label
        >
        <a
          class="language-link"
          href={locale === "zh" ? "/" : "/zh/"}
          lang={locale === "zh" ? "en" : "zh-CN"}>{c.languageLabel}</a
        >
      </div>
    </div>
  </header>
  <main id="main">
    <div class="arrival-journey">
      <section class="hero page-shell" aria-labelledby="hero-title">
        <div class="hero-horizon" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="signal-dot" aria-hidden="true"></span>{c.hero.eyebrow}
          </p>
          <h1 id="hero-title">
            <span>{c.hero.lead}</span><em>{c.hero.emphasis}</em>
          </h1>
          <p class="hero-body">{c.hero.body}</p>
          <div class="hero-actions">
            <a class="button button--primary" href="#experience"
              >{c.hero.enter}<span aria-hidden="true">↗</span></a
            >
            <a class="text-link" href="#difference"
              >{c.hero.secondary}<span aria-hidden="true">↓</span></a
            >
          </div>
          <p class="hero-meta">{c.hero.note}</p>
        </div>
        <div class="identity-universe" data-identity="0">
          <div class="universe-coordinate" aria-hidden="true">
            PERSISTENCE<br />× OBSERVATION
          </div>
          <div class="universe-ring ring-one" aria-hidden="true"></div>
          <div class="universe-ring ring-two" aria-hidden="true"></div>
          <div class="universe-ring ring-three" aria-hidden="true"></div>
          <button
            class="hero-identity"
            aria-label={c.hero.interact}
            type="button"
          >
            {
              identities.map((identity, index) => (
                <span class="hero-contour" hidden={index !== 0}>
                  <IdentityContour identity={identity} />
                </span>
              ))
            }
            <span class="identity-touch"
              >{c.hero.interact}<span aria-hidden="true">↻</span></span
            >
          </button>
          <span class="universe-spark spark-one" aria-hidden="true">+</span>
          <span class="universe-spark spark-two" aria-hidden="true">+</span>
          <div class="identity-caption" aria-live="polite">
            {
              c.hero.names.map((name, index) => (
                <div hidden={index !== 0}>
                  <>
                    <span>{c.hero.tags[index]}</span>
                    <strong>{name}</strong>
                  </>
                </div>
              ))
            }
          </div>
          <div
            class="identity-choices"
            role="group"
            aria-label={locale === "zh"
              ? "探索身份轮廓"
              : "Explore identity shapes"}
          >
            {
              c.hero.names.map((name, index) => (
                <button
                  type="button"
                  data-identity-choice={index}
                  aria-label={name}
                  aria-pressed={index === 0}
                >
                  <span aria-hidden="true">0{index + 1}</span>
                </button>
              ))
            }
          </div>
        </div>
        <div class="hero-floor">
          <a href="#experience"
            ><span class="scroll-tether" aria-hidden="true">↓</span>{
              c.hero.scroll
            }</a
          ><span>{c.hero.marker}</span><span aria-hidden="true">01 — ∞</span>
        </div>
      </section>
      <section
        id="experience"
        class="portal-section"
        aria-labelledby="demo-title"
      >
        <div class="portal-heading page-shell">
          <div>
            <p class="eyebrow">{c.demo.eyebrow}</p><h2 id="demo-title">
              {c.demo.title}
            </h2>
          </div>
          <p>{c.demo.body}</p>
        </div>
        <div class="portal-berth">
          <div class="portal-window" id="portal-window">
            <button
              id="demo-expand"
              type="button"
              aria-expanded="false"
              aria-controls="demo-frame"
              data-open-label={c.demo.expand}
              data-close-label={c.demo.close}
              >{c.demo.expand}<span aria-hidden="true">↗</span></button
            >
            <div class="portal-canvas">
              <div class="demo-loading" role="status">
                <IdentityContour /><span>{c.demo.loading}</span><a
                  href={demoHref}>{c.demo.fallback}</a
                >
              </div>
              <iframe
                id="demo-frame"
                title={locale === "zh"
                  ? "VeriSilo — 中文交互演示"
                  : "VeriSilo — interactive product demo"}
                src={demoHref}
                loading="lazy"
                sandbox="allow-scripts allow-same-origin allow-forms allow-modals allow-downloads"
                allow="clipboard-write 'self'"></iframe>
            </div>
            <div class="portal-caption">
              <span>{c.demo.note}</span>
              <a href={demoHref} target="_blank" rel="noreferrer"
                >{c.demo.fallback}<span aria-hidden="true">↗</span></a
              >
            </div>
          </div>
        </div>
        <div class="portal-bottom page-shell">
          <p>{c.demo.version}</p><a href="#difference">{c.demo.exit}</a>
        </div>
        <p class="demo-mobile-note page-shell">{c.demo.mobile}</p>
      </section>
    </div>
    <section
      id="difference"
      class="principles page-shell"
      aria-labelledby="principles-title"
    >
      <div class="section-intro">
        <div>
          <p class="eyebrow">{c.principles.eyebrow}</p><h2
            id="principles-title"
          >
            {c.principles.title}
          </h2>
        </div>
        <p>{c.principles.intro}</p>
      </div>
      <div class="principle-list">
        {
          c.principles.items.map((item, index) => (
            <article class="principle">
              <span class="principle-number">0{index + 1}</span>
              <div class="principle-art" aria-hidden="true">
                {index === 0 ? (
                  <IdentityContour />
                ) : index === 1 ? (
                  <div class="evidence-sculpture">
                    <i />
                    <i />
                    <i />
                    <span>≍</span>
                  </div>
                ) : (
                  <div class="vault-sculpture">
                    <i />
                    <i />
                    <i />
                    <span>◌</span>
                  </div>
                )}
              </div>
              <div class="principle-copy">
                <>
                  <p class="eyebrow">{item.label}</p>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                  <small>{item.aside}</small>
                </>
              </div>
            </article>
          ))
        }
      </div>
    </section>
    <section
      class="evidence-section"
      id="evidence"
      aria-labelledby="evidence-title"
    >
      <div class="page-shell evidence-layout">
        <div class="evidence-intro">
          <p class="eyebrow">{c.evidence.eyebrow}</p><h2 id="evidence-title">
            {c.evidence.title}
          </h2><p>{c.evidence.intro}</p><a
            class="text-link"
            href={links.capabilities}
            target="_blank"
            rel="noreferrer">{c.evidence.link} ↗</a
          >
        </div>
        <div class="evidence-lab" data-evidence="0">
          <p class="lab-label">{c.evidence.sample}</p>
          <div
            class="evidence-choices"
            role="group"
            aria-label={locale === "zh"
              ? "选择观测示例"
              : "Choose an observation"}
          >
            {
              c.evidence.choices.map((label, index) => (
                <button
                  type="button"
                  aria-pressed={index === 0}
                  data-evidence-choice={index}
                >
                  {label}
                </button>
              ))
            }
          </div>
          <div class="observation-pair">
            <div class="observation declaration">
              <span>{c.evidence.expected}</span><strong
                >America/<wbr />New_York</strong
              ><i aria-hidden="true">01</i>
            </div>
            <div class="evidence-connector" aria-hidden="true">
              <i></i><span>≍</span><i></i>
            </div>
            <div class="observation observation-result">
              <span>{c.evidence.observed}</span>
              {
                c.evidence.observations.map((value, index) => (
                  <strong hidden={index !== 0}>
                    {value.includes("/") ? (
                      <>
                        {value.split("/")[0]}/<wbr />
                        {value.split("/")[1]}
                      </>
                    ) : (
                      value
                    )}
                  </strong>
                ))
              }
              <i aria-hidden="true">02</i>
            </div>
          </div>
          <div class="lab-result" aria-live="polite">
            {
              c.evidence.states.map((state, index) => (
                <div hidden={index !== 0}>
                  <>
                    <strong>
                      <span aria-hidden="true">{["≍", "≠", "∅"][index]}</span>
                      {state}
                    </strong>
                    <p>{c.evidence.explanations[index]}</p>
                  </>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
    <section class="boundaries page-shell" id="boundaries">
      <div class="section-intro">
        <div>
          <p class="eyebrow">{c.boundaries.eyebrow}</p><h2>
            {c.boundaries.title}
          </h2>
        </div><a
          class="text-link"
          href={links.threatModel}
          target="_blank"
          rel="noreferrer">{c.boundaries.link} ↗</a
        >
      </div>
      <div class="boundary-list">
        {
          c.boundaries.items.map((item, index) => (
            <details>
              <>
                <summary>
                  <span>0{index + 1}</span>
                  {item.title}
                  <i aria-hidden="true">+</i>
                </summary>
                <p>{item.text}</p>
              </>
            </details>
          ))
        }
      </div>
    </section>
    <section
      class="download-section"
      id="download"
      aria-labelledby="download-title"
    >
      <div class="download-orbit" aria-hidden="true">
        <IdentityContour identity="creative-workspace" />
      </div>
      <div class="page-shell download-layout">
        <div class="download-copy">
          <p class="eyebrow">{c.download.eyebrow}</p><h2 id="download-title">
            {c.download.title}
          </h2><p>{c.download.body}</p>
          <div class="download-actions">
            <a class="button button--light" href={links.releaseInstaller}
              >{c.download.action}<span aria-hidden="true">↓</span></a
            ><a
              class="text-link"
              href={links.repository}
              target="_blank"
              rel="noreferrer">{c.download.source} ↗</a
            >
          </div>
          <span class="download-version">{c.download.version}</span><a
            class="release-details"
            href={links.release}
            target="_blank"
            rel="noreferrer">{c.download.verify}</a
          ><p class="download-note">{c.download.note}</p>
        </div>
        <div class="download-brand" aria-hidden="true">
          <BrandMark size="large" />
        </div>
      </div>
      <footer class="page-shell site-footer">
        <a class="wordmark" href={homeHref}
          ><BrandMark /><span>VeriSilo</span></a
        ><p>{c.download.footer}</p><div class="footer-links">
          <a href={locale === "zh" ? "/zh/privacy/" : "/privacy/"}
            >{c.download.privacy}</a
          ><a href={links.license} target="_blank" rel="noreferrer"
            >{c.download.license}</a
          ><a href={links.repository} target="_blank" rel="noreferrer"
            >GitHub ↗</a
          >
        </div>
      </footer>
    </section>
  </main>
  <script>
    import "../scripts/living-site";
  </script>
</BaseLayout>
