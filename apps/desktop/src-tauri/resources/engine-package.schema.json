{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verisilo.local/schemas/engine-package.schema.json",
  "title": "VeriSilo external engine package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engineId",
    "engineVersion",
    "channel",
    "platform",
    "executableRelativePath",
    "artifactSha256",
    "signature",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "engineId": { "enum": ["controlled-chromium", "camoufox"] },
    "engineVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:[1-9][0-9]{2})\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "channel": { "const": "experimental" },
    "platform": { "const": "windows-x64" },
    "executableRelativePath": {
      "enum": ["bin/chromium.exe", "bin/camoufox.exe"]
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "cms-detached-sha256" },
        "keyId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "value": {
          "type": "string",
          "minLength": 256,
          "maxLength": 60000,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 17,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity_template",
          "ua_ua_ch",
          "language_timezone",
          "screen",
          "canvas",
          "webgl",
          "fonts",
          "media_devices",
          "request_headers",
          "window",
          "iframe",
          "dedicated_worker",
          "site_fallback"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "engineId": { "const": "controlled-chromium" } }
      },
      "then": {
        "properties": {
          "executableRelativePath": { "const": "bin/chromium.exe" }
        }
      }
    },
    {
      "if": { "properties": { "engineId": { "const": "camoufox" } } },
      "then": {
        "properties": {
          "executableRelativePath": { "const": "bin/camoufox.exe" }
        }
      }
    },
    {
      "properties": {
        "capabilities": { "contains": { "const": "identity_template" } }
      }
    },
    {
      "properties": {
        "capabilities": { "contains": { "const": "site_fallback" } }
      }
    }
  ]
}
