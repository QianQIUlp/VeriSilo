{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verisilo.local/schemas/engine-package.schema.json",
  "title": "VeriSilo external engine package manifest",
  "oneOf": [
    {
      "title": "Controlled Chromium package v2",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "engineId",
        "engineVersion",
        "channel",
        "platform",
        "executableRelativePath",
        "artifactSha256",
        "signature",
        "capabilities"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "engineId": { "const": "controlled-chromium" },
        "engineVersion": { "$ref": "#/$defs/engineVersion" },
        "channel": { "const": "experimental" },
        "platform": { "const": "windows-x64" },
        "executableRelativePath": { "const": "bin/chromium.exe" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "signature": { "$ref": "#/$defs/signature" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      },
      "allOf": [{ "$ref": "#/$defs/requiredCapabilities" }]
    },
    {
      "title": "Camoufox Host package v3",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "engineId",
        "engineVersion",
        "channel",
        "platform",
        "artifactSha256",
        "signature",
        "capabilities",
        "entrypoint",
        "treeManifest",
        "browserTreeManifest",
        "hostVersion",
        "browserRelease",
        "browserAssetSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 3 },
        "engineId": { "const": "camoufox" },
        "engineVersion": { "$ref": "#/$defs/engineVersion" },
        "channel": { "const": "experimental" },
        "platform": { "const": "windows-x64" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "signature": { "$ref": "#/$defs/signature" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "entrypoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "relativePath", "protocol", "sha256"],
          "properties": {
            "kind": { "const": "camoufox-host-v1" },
            "relativePath": { "$ref": "#/$defs/relativePath" },
            "protocol": { "const": "verisilo-camoufox-host/v1" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "treeManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relativePath", "sha256"],
          "properties": {
            "relativePath": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "browserTreeManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relativePath", "sha256"],
          "properties": {
            "relativePath": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "hostVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "browserRelease": {
          "type": "string",
          "pattern": "^v(?:[1-9][0-9]{2})\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "browserAssetSha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [{ "$ref": "#/$defs/requiredCamoufoxCapabilities" }]
    }
  ],
  "$defs": {
    "engineVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:[1-9][0-9]{2})\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?![\\\\/])(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "cms-detached-sha256" },
        "keyId": { "$ref": "#/$defs/sha256" },
        "value": {
          "type": "string",
          "minLength": 256,
          "maxLength": 60000,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity_template",
          "ua_ua_ch",
          "language_timezone",
          "screen",
          "canvas",
          "webgl",
          "fonts",
          "media_devices",
          "request_headers",
          "window",
          "iframe",
          "dedicated_worker",
          "site_fallback"
        ]
      }
    },
    "requiredCapabilities": {
      "properties": {
        "capabilities": {
          "allOf": [
            { "contains": { "const": "identity_template" } },
            { "contains": { "const": "site_fallback" } }
          ]
        }
      }
    },
    "requiredCamoufoxCapabilities": {
      "properties": {
        "capabilities": {
          "allOf": [
            { "contains": { "const": "identity_template" } },
            { "not": { "contains": { "const": "site_fallback" } } }
          ]
        }
      }
    }
  }
}
