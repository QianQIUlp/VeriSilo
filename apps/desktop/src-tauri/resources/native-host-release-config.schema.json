{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VeriSilo Native Host release configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "chromeExtensionId", "edgeExtensionId"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "chromeExtensionId": {
      "type": "string",
      "pattern": "^[a-p]{32}$"
    },
    "edgeExtensionId": {
      "type": "string",
      "pattern": "^[a-p]{32}$"
    }
  }
}
