{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verisilo:hyperv-image-source:1",
  "title": "VeriSilo Hyper-V release image source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "repository",
    "artifactId",
    "imageFile",
    "imageSha256",
    "redistributionAcknowledged"
  ],
  "properties": {
    "schema": {
      "const": "urn:verisilo:hyperv-image-source:1"
    },
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "artifactId": {
      "type": "integer",
      "minimum": 1
    },
    "imageFile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,119}\\.vhdx$",
      "not": {
        "pattern": "^(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$)"
      }
    },
    "imageSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "redistributionAcknowledged": {
      "const": true
    }
  }
}
