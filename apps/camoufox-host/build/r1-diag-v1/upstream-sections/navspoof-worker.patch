 uint64_t WorkerNavigator::HardwareConcurrency() const {
+  // Camoufox: per-context hardware concurrency for workers
+  {
+    WorkerPrivate* wp = GetCurrentThreadWorkerPrivate();
+    if (wp) {
+      uint32_t ucid = wp->GetOriginAttributes().mUserContextId;
+      uint32_t stored = mozilla::dom::NavigatorManager::GetHardwareConcurrency(ucid);
+      if (stored > 0) {
+        return static_cast<uint64_t>(stored);
