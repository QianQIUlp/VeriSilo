 void WorkerNavigator::GetPlatform(nsString& aPlatform, CallerType aCallerType,
                                   ErrorResult& aRv) const {
+  // Camoufox: per-context navigator platform for workers
+  {
+    WorkerPrivate* wp = GetCurrentThreadWorkerPrivate();
+    if (wp) {
+      uint32_t ucid = wp->GetOriginAttributes().mUserContextId;
+      nsAutoString stored;
+      if (mozilla::dom::NavigatorManager::GetPlatform(ucid, stored)) {
+        aPlatform = stored;
+        return;
+      }
