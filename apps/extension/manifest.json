{
  "manifest_version": 3,
  "name": "VeriSilo Companion",
  "version": "0.2.2",
  "description": "Browser identity checks, opt-in network verification, and lightweight local isolation for VeriSilo.",
  "action": {
    "default_title": "Open VeriSilo"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "optional_permissions": ["privacy"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
