{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.2.8",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/verisilo-16.png",
    "32": "icons/verisilo-32.png",
    "48": "icons/verisilo-48.png",
    "128": "icons/verisilo-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/verisilo-16.png",
      "32": "icons/verisilo-32.png",
      "48": "icons/verisilo-48.png",
      "128": "icons/verisilo-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "optional_permissions": ["privacy"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
