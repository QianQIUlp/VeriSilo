{
  "manifest_version": 3,
  "name": "VeriSilo Companion",
  "version": "0.2.4",
  "description": "Browser identity checks, opt-in network verification, and lightweight local isolation for VeriSilo.",
  "icons": {
    "16": "icons/verisilo-16.png",
    "32": "icons/verisilo-32.png",
    "48": "icons/verisilo-48.png",
    "128": "icons/verisilo-128.png"
  },
  "action": {
    "default_title": "Open VeriSilo",
    "default_icon": {
      "16": "icons/verisilo-16.png",
      "32": "icons/verisilo-32.png",
      "48": "icons/verisilo-48.png",
      "128": "icons/verisilo-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "optional_permissions": ["privacy"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
